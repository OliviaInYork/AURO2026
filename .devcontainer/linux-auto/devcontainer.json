{
  "name": "auro-linux-auto",
  "image": "ghcr.io/uoy-robostar/ros2-lyrical-tb3/auro-dev:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/auro,type=bind",
  "workspaceFolder": "/workspaces/auro",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-host,type=bind",
    "source=/,target=/host-root,type=bind"
  ],
  "postStartCommand": "DISP=\"${localEnv:DISPLAY:-:0}\" && NUM=$(echo \"$DISP\" | grep -oE '[0-9]+' | head -n1) && ln -sf \"/tmp/.X11-host/X$NUM\" \"/tmp/.X11-unix/X$NUM\" ; ${containerWorkspaceFolder}/.devcontainer/config.sh ; sudo bash ${containerWorkspaceFolder}/.devcontainer/linux-auto/setup-gpu-auto.sh ; ${containerWorkspaceFolder}/.devcontainer/fix-permissions.sh",
  "remoteUser": "ubuntu",
  "portsAttributes": {
      "6080": {
          "label": "Desktop"
      }
  },
  "remoteEnv": {
    "USERNAME": "${localEnv:USERNAME}",
    "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}",
    "LMODULES": "${localEnv:LOADEDMODULES}",
    "DISPLAY": "${localEnv:DISPLAY}",
    "HOST_XAUTHORITY": "${localEnv:XAUTHORITY}",
    "HOST_HOME": "${localEnv:HOME}",
    "QT_QPA_PLATFORM": "xcb"
  },
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "graphics,utility,compute,display",
    "DISPLAY": ":4",
    "QT_QPA_PLATFORM": "xcb"
  }
}
