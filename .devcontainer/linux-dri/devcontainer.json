// Use this devcontainer.json to develop within a standard environment,
// with X11 forwarding via /dev/dri. This is compatible with Intel/AMD cards and
// the open-source nvidia driver.
//
// It requires that ~/.Xauthority in the host points to $XAUTHORITY.
{
  "name": "auro-linux-dri",
  "image": "ghcr.io/uoy-robostar/ros2-lyrical-tb3/auro-dev:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/auro,type=bind",
  "workspaceFolder": "/workspaces/auro",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-host,type=bind",
    "source=${localEnv:HOME}/.Xauthority,target=/home/ubuntu/.Xauthority,type=bind"
  ],
  "postStartCommand": "DISP=\"${localEnv:DISPLAY:-:0}\" && NUM=$(echo \"$DISP\" | grep -oE '[0-9]+' | head -n1) && ln -sf \"/tmp/.X11-host/X$NUM\" \"/tmp/.X11-unix/X$NUM\" ; ${containerWorkspaceFolder}/.devcontainer/config.sh",
  "runArgs": [
    "--device", "/dev/dri"
  ],
  "remoteUser": "ubuntu",
  "portsAttributes": {
      "6080": {
          "label": "Desktop"
      }
  },
  "remoteEnv": {
    "USERNAME": "${localEnv:USERNAME}",
    "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}",
    "LMODULES": "${localEnv:LOADEDMODULES}",
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "containerEnv": {
    // We set the built-in X11/vnc to use display 2 by default.
    "DISPLAY": ":4",
    "QT_QPA_PLATFORM": "xcb"
  }
}
