package myPackage

interface IOperations {
	cmd_vel (   msg : TwistStamped )
}

interface IEvents {
	event scan : Seq( real )
}

robotic platform TurtleBot {
	uses IEvents 
	provides IOperations 
}

datatype Twist { 
	linear : Vector3
	angular : Vector3
} 

datatype Vector3 { 
	x : real 
	y : real 
	z : real
} type Header datatype TwistStamped { header : Header twist : Twist } 

  


controller Driving {
	requires IOperations 
	stm StateMachine {
		const lvel : real, avel : real
		requires IOperations 
		state Forward {
			entry cmd_vel ( TwistStamped (| header = default ( ) , twist = Twist (| linear = Vector3 (| x = lvel , y = 0 , z = 0 |) , angular = Vector3 (| x = 0 , y = 0 , z = 0 |) |) |) ) ; wait ( 4 )
		}

		transition t1 {
			from Forward
			to Turning
		}

	state Turning {
			entry cmd_vel ( TwistStamped (| header = default ( ) , twist = Twist (| linear = Vector3 (| x = 0 , y = 0 , z = 0 |) , angular = Vector3 (| x = 0 , y = 0 , z = avel |) |) |) ) ; wait ( 1 )
		}
		transition t2 {
			from Turning
			to Forward
			}
		initial I
		transition t0 {
			from I to
			Forward
		}
	}

}

module Module {
	rref rp_ref0 = TurtleBot
	cref ctrl_ref0 = Driving
}

function default ( ) : Header { }